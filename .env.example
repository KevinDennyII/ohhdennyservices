# Public (safe to expose to the browser / Vite)
VITE_TURNSTILE_SITE_KEY=

# Server / Netlify Function secrets (set in Infisical + Netlify env)
TURNSTILE_SECRET_KEY=
# Gmail SMTP auth (sends the contact notification)
EMAIL_USER=
EMAIL_PASS=
# Optional override; defaults to kevin@ohhdennyservices.com in shared/site.ts
CONTACT_TO=

# Local Express only
PORT=8080

# Cloudflare Turnstile test keys (always pass):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
